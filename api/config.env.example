# Copy to api/config.env. DB, Redis and ML settings are set by docker-compose.yml.
API_PORT=8005
LOG_LEVEL=info

# Generate each with: openssl rand -hex 32  (JWT_ADMIN_SECRET must differ from JWT_SECRET)
JWT_SECRET=
JWT_ADMIN_SECRET=
NIC_PEPPER=

# The portals' https origins
CORS_ORIGINS=https://farmer.example.com,https://admin.example.com

TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=yala-maha
SMS_DRY_RUN=false

ALERT_THRESHOLD=90
ALERT_RECIPIENTS=

# Weather advisories from the Department of Meteorology CAP feed (services/weatherFeedJob.js).
# Polled every 15 minutes with a conditional request. Can also be switched off at runtime
# from the admin portal (app_settings.weather_feed).
MET_FEED_BASE=https://was.meteo.gov.lk/cap
# Point MET_FEED_BASE at a local static server holding saved CAP files while developing,
# so a restart loop never touches the government server.
WEATHER_FEED_ENABLED=true

# Warning calls (services/stormCallJob.js): a voice call when very heavy rain or strong winds are
# forecast (Open-Meteo) at a farmer's location up to STORM_DAYS_AHEAD days ahead, or when the ML
# model expects the farmer's tank to spill within 14 days.
# off | dry-run | trial | live. trial = Twilio free trial: only TWILIO_VERIFIED_NUMBERS are rung.
STORM_CALL_MODE=trial
# weather, ml or both
STORM_CALL_SOURCES=weather,ml
# si (SinhalaVITS) | en | si+en. Sinhala falls back to English if SinhalaVITS or PUBLIC_API_URL fails.
STORM_CALL_LANG=si
SINHALA_VOICE=female1
# Twilio downloads the Sinhala audio from here, so it must be this API's public https address
PUBLIC_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# comma separated, the numbers under Twilio Console > Phone Numbers > Verified Caller IDs
TWILIO_VERIFIED_NUMBERS=
STORM_CALL_MAX_PER_RUN=3
STORM_DAYS_AHEAD=4
STORM_RAIN_MM=100
STORM_GUST_KMH=70
# ML: predicted fill (% of capacity) that counts as spilling, and days before re-calling about one tank
ML_SPILL_PCT=100
ML_REPEAT_DAYS=7
