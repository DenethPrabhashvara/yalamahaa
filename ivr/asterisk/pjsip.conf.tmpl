; Registers to pbx.im as one endpoint; pbx.im sends that endpoint's calls here.

[global]
type=global
user_agent=YalaMaha-IVR

; pbx.im answers SIP over TCP (UDP got no reply in testing)
[transport-tcp]
type=transport
protocol=tcp
bind=0.0.0.0:5060
external_media_address=$PUBLIC_IP
external_signaling_address=$PUBLIC_IP
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[pbxim-reg]
type=registration
transport=transport-tcp
outbound_auth=pbxim-auth
server_uri=sip:$PBXIM_HOST:$PBXIM_PORT;transport=tcp
client_uri=sip:$PBXIM_USER@$PBXIM_HOST
contact_user=$PBXIM_USER
expiration=300
retry_interval=60
forbidden_retry_interval=600
max_retries=10000

[pbxim-auth]
type=auth
auth_type=userpass
username=$PBXIM_USER
password=$PBXIM_PASSWORD

[pbxim]
type=aor
contact=sip:$PBXIM_HOST:$PBXIM_PORT;transport=tcp
qualify_frequency=60

[pbxim]
type=endpoint
transport=transport-tcp
context=from-pbxim
disallow=all
allow=alaw,ulaw
aors=pbxim
outbound_auth=pbxim-auth
from_user=$PBXIM_USER
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

; Only the pbx.im SIP server may send calls in (match takes a hostname or IP). Anything else has no endpoint and is rejected.
[pbxim]
type=identify
endpoint=pbxim
match=$PBXIM_HOST
