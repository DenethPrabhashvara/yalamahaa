{$FARMER_DOMAIN} {
	encode zstd gzip
	handle_path /ai/* {
		reverse_proxy ai:5050
	}
	handle /api/* {
		reverse_proxy api:8005
	}
	handle {
		root * /srv/farmer
		# Built files have a content hash in their name, so phones can keep them; index.html is
		# checked every launch so a new build is picked up straight away.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page path / /index.html
		header @page Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	handle /admin/* {
		reverse_proxy api:8005
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
